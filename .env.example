# ─── Server ───────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/foodbridge_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=foodbridge_db
PGUSER=your_db_user
PGPASSWORD=your_db_password

# ─── Google OAuth ─────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── Session ──────────────────────────────────────
SESSION_SECRET=your_super_secret_session_key

# ─── AI API (for food quality check) ──────────────
AI_API_KEY=your_ai_api_key
AI_API_URL=https://api.your-ai-provider.com

# ─── Client ───────────────────────────────────────
# Comma-separated allowlist (e.g. http://localhost:3000,https://food-b-ridge-demo.vercel.app)
# If multiple URLs are supplied, the first URL is used for OAuth redirect targets.
CLIENT_URL=http://localhost:3000

# ─── Frontend (Vercel/React) ─────────────────────
# Set this in the frontend project envs (NOT in backend envs):
# REACT_APP_API_BASE_URL=https://foodbridge-backend.vercel.app/api
# REACT_APP_ENABLE_GOOGLE_AUTH=false

# ─── Payments (Razorpay) ─────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
