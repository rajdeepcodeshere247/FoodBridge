PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/foodbridge_db
PG_SSL_REJECT_UNAUTHORIZED=false

# Sessions
SESSION_SECRET=replace_with_a_long_random_secret

# Frontend app URLs allowed for CORS + OAuth redirect target.
# Comma-separated if you have multiple URLs.
CLIENT_URL=http://localhost:3000

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional on Vercel if VERCEL_URL is available.
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary (recommended for production image uploads)
# If omitted, server falls back to storing base64 image data in PostgreSQL.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=foodbridge

# Optional AI integration
AI_API_KEY=
